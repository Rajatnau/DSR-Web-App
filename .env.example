# Copy to .env for local runs and adjust. Never commit the real .env.
# On Vercel, set these in Project Settings -> Environment Variables instead
# (the .env file is never deployed).

# --- Runtime ---------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Security --------------------------------------------------------
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# true when the app sits behind an HTTPS reverse proxy. Automatic on Vercel.
TRUST_PROXY=false
# Secure cookies. Defaults to true when NODE_ENV=production. Set false ONLY for
# plain-HTTP use on a LAN, or nobody will be able to sign in.
SECURE_COOKIES=true
SESSION_HOURS=12

# --- Bootstrap admin (only used the very first time the DB is created) ---
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@123

# --- Database --------------------------------------------------------
# Leave empty to use a local SQLite file at $DATA_DIR/dsr.db.
# PostgreSQL: DATABASE_URL=postgres://user:password@host/dbname
#   (Vercel Storage -> Postgres sets this for you; POSTGRES_URL also works.)
# Turso:      DATABASE_URL=libsql://... plus DATABASE_AUTH_TOKEN=...
#   (TURSO_DATABASE_URL / TURSO_AUTH_TOKEN are also accepted.)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Storage ---------------------------------------------------------
# Where dsr.db (local mode), DSR.xlsx and backups/ live.
DATA_DIR=./data
# Rewrite DSR.xlsx after every change. Needs a persistent disk; defaults to
# true locally and false on Vercel.
EXCEL_FILE_SYNC=true

# --- Excel live feed (optional) --------------------------------------
# Enables /api/export/dsr.xlsx?token=<value> so Excel Power Query or Power BI
# can refresh without signing in. At least 24 characters. Leave empty to
# disable. Generate with the same command as SESSION_SECRET.
EXPORT_TOKEN=

# --- Business rules --------------------------------------------------
CURRENCY=INR
STANDARD_HOURS_PER_DAY=8
MAX_HOURS_PER_DAY=16
# IANA timezone that defines "today" for your team. Important on Vercel,
# whose clock is UTC.
APP_TIMEZONE=Asia/Kolkata
