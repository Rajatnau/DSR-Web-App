# Copy to .env and adjust. Never commit the real .env.

# --- Runtime ---------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Security --------------------------------------------------------
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to true when the app sits behind an HTTPS reverse proxy or PaaS
# (Render, Railway, Azure App Service, nginx, IIS ARR).
TRUST_PROXY=false
# Forces Secure cookies. Defaults to true when NODE_ENV=production.
SECURE_COOKIES=true
SESSION_HOURS=12

# --- Bootstrap admin (only used the very first time the DB is created) ---
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@123

# --- Storage ---------------------------------------------------------
# Where dsr.db, DSR.xlsx and backups/ live. Point this at a persistent
# volume when deploying to a container platform.
DATA_DIR=./data

# --- Business rules --------------------------------------------------
CURRENCY=INR
STANDARD_HOURS_PER_DAY=8
MAX_HOURS_PER_DAY=16
